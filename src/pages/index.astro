---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const latestPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

// 动态获取所有不重复的标签
const allTags = [...new Set(allPosts.map((post) => post.data.tags || []).flat())];
---

<Layout title="小千的个人主页 | 探索与记录">
    <!-- 头部标题 -->
    <header class="py-24 text-center animate-fade-in-up">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 tracking-tight">小千的个人主页</h1>
        <p class="text-slate-500 dark:text-slate-400 text-lg h-8">
            <span id="typewriter"></span><span class="animate-pulse border-r-2 border-indigo-500 ml-1"></span>
        </p>
    </header>

    <main class="max-w-5xl mx-auto px-6 pb-20">
        <div class="flex flex-col md:flex-row gap-12">
            
            <!-- 文章列表区域 (左侧) -->
            <div class="flex-1 space-y-12">
                {latestPosts.length > 0 ? (
                    latestPosts.map((post) => (
                        <article class="post-card reveal active">
                            <div class="flex items-center gap-3 text-xs text-slate-400 mb-3">
                                <span>{post.data.pubDate.toLocaleDateString()}</span>
                                <span>•</span>
                                <span>约 {post.body.length} 字</span>
                            </div>
                            <a href={`/posts/${post.slug}`}>
                                <h2 class="text-xl font-bold mb-3 transition-colors hover:text-indigo-600 dark:text-slate-100">
                                    {post.data.title}
                                </h2>
                            </a>
                            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed line-clamp-3">
                                {post.data.description}
                            </p>
                        </article>
                    ))
                ) : (
                    <div class="reveal py-20 text-center border border-dashed border-slate-200 dark:border-slate-800 rounded-3xl bg-white/50 dark:bg-slate-800/50 shadow-sm">
                        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-700 mb-6">
                            <i class="fa-regular fa-folder-open text-3xl text-slate-400"></i>
                        </div>
                        <p class="text-slate-500 dark:text-slate-400 font-medium">文章正在准备中，敬请期待...</p>
                        <p class="text-slate-400 dark:text-slate-500 text-xs mt-2 italic">Coming soon</p>
                    </div>
                )}
            </div>

            <!-- 侧边栏 (右侧) -->
            <aside class="w-full md:w-64 space-y-12 reveal">
                <!-- 个人信息 -->
                <section class="text-center md:text-left group">
                    <div class="relative inline-block md:block mb-6">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-1.2.1&auto=format&fit=crop&w=200&q=80" alt="Avatar" class="w-24 h-24 rounded-3xl mx-auto md:mx-0 object-cover grayscale group-hover:grayscale-0 transition-all duration-500 shadow-xl group-hover:rotate-3" />
                        <div class="absolute -bottom-2 -right-2 w-6 h-6 bg-green-500 border-4 border-slate-50 dark:border-slate-900 rounded-full"></div>
                    </div>
                    <h3 class="text-xl font-bold mb-1">小千</h3>
                    <p class="text-slate-500 dark:text-slate-400 text-xs mb-4">动画爱好者</p>
                    <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6">
                        这是我的个人空间。在这里分享日常生活与思考。
                    </p>
                    <div class="flex justify-center md:justify-start gap-5 text-slate-400 dark:text-slate-500">
                        <a href="#" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors text-xl"><i class="fa-brands fa-github"></i></a>
                        <a href="#" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors text-xl"><i class="fa-brands fa-twitter"></i></a>
                        <a href="#" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors text-xl"><i class="fa-solid fa-envelope"></i></a>
                        <a href="#" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors text-xl"><i class="fa-solid fa-rss"></i></a>
                    </div>
                </section>

                <!-- 统计数据 -->
                <section class="grid grid-cols-2 gap-4 border-y border-slate-200 dark:border-slate-800 py-8 text-center bg-white/30 dark:bg-slate-800/30 rounded-2xl md:bg-transparent md:rounded-none md:border-x-0">
                    <a href="/posts" class="group transition-colors">
                        <div class="text-xl font-bold group-hover:text-indigo-600">{allPosts.length}</div>
                        <div class="text-[10px] text-slate-400 uppercase tracking-widest mt-1">文章</div>
                    </a>
                    <a href="#tags" class="group transition-colors">
                        <div class="text-xl font-bold group-hover:text-indigo-600">{allTags.length}</div>
                        <div class="text-[10px] text-slate-400 uppercase tracking-widest mt-1">标签云</div>
                    </a>
                </section>

                <!-- 标签云 -->
                <section id="tags">
                    <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-tags text-[10px]"></i> 标签云
                    </h4>
                    <div class="flex flex-wrap gap-2">
                        {allTags.length > 0 ? (
                            allTags.map((tag) => (
                                <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs text-slate-600 dark:text-slate-400 rounded-full">#{tag}</span>
                            ))
                        ) : (
                            <span class="text-xs text-slate-400 italic">暂无标签</span>
                        )}
                    </div>
                </section>

                <!-- 位置 -->
                <section class="pt-4">
                    <p class="text-xs text-slate-400 flex items-center gap-2 italic">
                        <i class="fa-solid fa-location-dot animate-bounce text-indigo-500"></i>
                        <span id="user-location">正在识别您的位置...</span>
                    </p>
                </section>
            </aside>
        </div>
    </main>

    <script is:inline>
        // 打字机效果
        const text = "记录生活的点滴";
        const typewriterElement = document.getElementById('typewriter');
        let index = 0;

        function type() {
            if (index < text.length) {
                typewriterElement.textContent += text.charAt(index);
                index++;
                setTimeout(type, 150);
            }
        }
        setTimeout(type, 1000);

        // IP 地理位置识别
        async function fetchLocation() {
            const locationElement = document.getElementById('user-location');
            try {
                const response = await fetch('https://ipapi.co/json/');
                const data = await response.json();
                if (data.city && data.country_name) {
                    locationElement.textContent = `${data.city}, ${data.country_name}`;
                }
            } catch (error) {
                locationElement.textContent = "北京, 中国";
            }
        }
        fetchLocation();
    </script>
</Layout>

<style>
    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
    }
    @keyframes fadeInUp {
        0% { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
    }
</style>
