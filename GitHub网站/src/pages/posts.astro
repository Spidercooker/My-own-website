---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="文章 | 我的个人主页">
	<main class="max-w-3xl mx-auto px-6 py-20 animate-fade-in-up">
		<h1 class="text-4xl font-bold mb-12 text-slate-900 dark:text-slate-100">文章</h1>
		
		<div class="space-y-12">
			{posts.map((post) => (
				<article class="post-card reveal active">
					<div class="flex items-center gap-3 text-xs text-slate-400 mb-3">
						<span>{post.data.pubDate.toLocaleDateString()}</span>
						<span>•</span>
						<span>约 {post.body.length} 字</span>
					</div>
					<a href={`/posts/${post.slug}`}>
						<h2 class="text-xl font-bold mb-3 transition-colors hover:text-indigo-600 dark:text-slate-100">
							{post.data.title}
						</h2>
					</a>
					<p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed line-clamp-3">
						{post.data.description}
					</p>
				</article>
			))}
		</div>
	</main>
</Layout>
